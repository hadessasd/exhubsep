# Required on Render
DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require
BETTER_AUTH_URL=https://examhub.shop
BETTER_AUTH_SECRET=paste-openssl-rand-hex-32-here
VITE_AUTH_ENABLED=true
NITRO_PRESET=node-server
NODE_ENV=production

# Stripe (webhook + activate)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: AES key for serial encryption (defaults to BETTER_AUTH_SECRET)
# SERIAL_ENCRYPTION_KEY=

# Optional Google (not required — email login works)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# OpenRouter reroute uses each caller's own Authorization: Bearer key.
# No server-side OpenRouter key is required.
